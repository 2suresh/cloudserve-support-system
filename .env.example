# Copy this file to .env and fill in your own values.
# Add .env to .gitignore before you put a real key in it.

# Use OpenRouter (default) OR Groq — set the one you have a free-tier key for.
OPENROUTER_API_KEY=your_key_here
# GROQ_API_KEY=your_key_here
# LLM_BASE_URL=https://api.groq.com/openai/v1   # only needed to override the default for your provider

MODEL_NAME=meta-llama/llama-3.1-8b-instruct
EMBEDDING_MODEL=all-MiniLM-L6-v2

CHROMA_PATH=./storage/chroma
DATABASE_URL=sqlite:///./storage/decisions.db

# Kill switch: set to false to disable every auto-response immediately, no deploy needed.
# Escalates everything instead of stopping the system. Checked on every ticket.
AUTO_RESPONSE_ENABLED=true

LOG_LEVEL=INFO
CONFIDENCE_THRESHOLD=0.80
RETRIEVAL_TOP_K=5
RETRIEVAL_RELEVANCE_THRESHOLD=0.30

LLM_MAX_RETRIES=3
LLM_TIMEOUT_SECONDS=20
LLM_BACKOFF_BASE_SECONDS=1.5
